Subject: [PATCH 3/3] Address code review feedback

- Simplify image loading to use io.ReadAll for reliability
- Add cleanup for marker event listeners on unmount
---
 app/components/Map.tsx      |    8 +
 package-lock.json           | 3832 +++++++++++++++++------------------
 server/workers/moderator.go |   22 +-
 3 files changed, 1875 insertions(+), 1987 deletions(-)

diff --git a/app/components/Map.tsx b/app/components/Map.tsx
index 24ce1ae..d9c1da4 100644
--- a/app/components/Map.tsx
+++ b/app/components/Map.tsx
@@ -126,6 +126,14 @@ export default function Map({ onMarkerClick }: MapProps) {
     );
 
     return () => {
+      // Clean up marker event listener
+      if (markerRef.current && markerClickHandlerRef.current) {
+        const el = markerRef.current.getElement();
+        el.removeEventListener("click", markerClickHandlerRef.current);
+        markerClickHandlerRef.current = null;
+      }
+      
+      // Clean up map
       if (mapRef.current) {
         mapRef.current.remove();
         mapRef.current = null;
