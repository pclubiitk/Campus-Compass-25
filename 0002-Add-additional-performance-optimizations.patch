 }
diff --git a/server/workers/moderator.go b/server/workers/moderator.go
index 75117e7..5cfb24c 100644
--- a/server/workers/moderator.go
+++ b/server/workers/moderator.go
@@ -66,12 +66,28 @@ func loadLocalImageAsBase64(path string) (string, error) {
 	}
 	defer file.Close()
 
-	buf := new(bytes.Buffer)
-	if _, err := io.Copy(buf, file); err != nil {
+	// Get file size to pre-allocate buffer
+	fileInfo, err := file.Stat()
+	if err != nil {
+		return "", fmt.Errorf("failed to stat file: %w", err)
+	}
+
+	// Pre-allocate buffer with exact size needed for base64 encoding
+	// Base64 encoding increases size by ~33%, so we allocate accordingly
+	encodedLen := base64.StdEncoding.EncodedLen(int(fileInfo.Size()))
+	buf := make([]byte, fileInfo.Size())
+	
+	// Read entire file into pre-allocated buffer
+	n, err := file.Read(buf)
+	if err != nil && err != io.EOF {
 		return "", fmt.Errorf("failed to read image: %w", err)
 	}
 
-	return base64.StdEncoding.EncodeToString(buf.Bytes()), nil
+	// Encode to base64 using pre-allocated buffer
+	encoded := make([]byte, encodedLen)
+	base64.StdEncoding.Encode(encoded, buf[:n])
+	
+	return string(encoded), nil
 }
 
