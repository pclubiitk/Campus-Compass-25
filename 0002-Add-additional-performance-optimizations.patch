     const form = document.querySelector("form")!;
 
     const rating = form.querySelector<HTMLInputElement>('input[name="rating-2"]:checked')?.getAttribute("aria-label")?.[0];
@@ -123,7 +129,7 @@ export default function LocationPage() {
       console.error("Submit error:", err);
       alert("Submission failed. Try again.");
     }
-  };
+  }, [id]);
 
 
   return (
diff --git a/server/model/userModel.go b/server/model/userModel.go
